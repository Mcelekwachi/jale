# Copy to .env for local development. Never commit .env.
APP_ENV=development

# Local docker compose value; Railway/Render/Supabase inject their own.
DATABASE_URL=postgresql://jale:jale@localhost:5432/jale

DEFAULT_LANGUAGE=ibo
# Explanation language for translations. ISO 639-3. Currently eng or nld.
DEFAULT_META_LANGUAGE=eng

# Supabase project settings. Keep the JWT secret server-side only.
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Comma separated. Add your Vercel preview and production URLs here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Let the container bring the database up on boot (handy on Render/Railway).
RUN_MIGRATIONS=false
RUN_SEED=false
SEED_LANGUAGES=ibo

DB_POOL_MIN=1
DB_POOL_MAX=5
WEB_CONCURRENCY=2
